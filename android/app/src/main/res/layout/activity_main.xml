<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/engine_title"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/engine_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEngineBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="Checking..."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 1: Protocols & Remote Servers (CDP & MCP) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="Protocols (DevTools &amp; AI Agents)"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- CDP Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chrome DevTools Protocol (CDP)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <EditText
                    android:id="@+id/editCdpPort"
                    android:layout_width="75dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:hint="9222"
                    android:inputType="number"
                    android:text="9222"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnToggleCdp"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:text="@string/start_cdp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCopyCdpEndpoint"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_outlined"
                    android:enabled="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Copy WS"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCdpStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="@string/cdp_status_stopped"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="@color/card_border" />

            <!-- MCP Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Model Context Protocol (MCP - AI Server)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <EditText
                    android:id="@+id/editMcpPort"
                    android:layout_width="75dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:hint="8080"
                    android:inputType="number"
                    android:text="8080"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnToggleMcp"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_accent"
                    android:text="@string/start_mcp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCopyMcpEndpoint"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_outlined"
                    android:enabled="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Copy SSE"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMcpStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mcp_status_stopped"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Card 2: Web Engine & Extraction -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="@string/browser_header"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Target URL -->
            <EditText
                android:id="@+id/editUrl"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_badge"
                android:hint="@string/enter_url_hint"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="https://example.com"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- Extraction Mode Selector -->
            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbHtml"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/mode_html"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbMarkdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mode_markdown"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mode_text"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbJs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mode_js"
                    android:textSize="12sp" />
            </RadioGroup>

            <!-- Optional JS Script input (shown only in JS Eval mode) -->
            <EditText
                android:id="@+id/editScript"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge"
                android:hint="@string/enter_script_hint"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="document.title"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Options Row (Stealth & Settle) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbStealth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Stealth (Anti-fingerprint)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/editSettleMs"
                    android:layout_width="95dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:hint="Settle 300ms"
                    android:inputType="number"
                    android:text="300"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Execute Button -->
            <Button
                android:id="@+id/btnExecute"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_primary"
                android:text="@string/execute_button"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Card 3: Output & Inspector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvOutputStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/output_header"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnClearOutput"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:text="@string/clear_output"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCopyOutput"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:text="@string/copy_output"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_code"
                android:maxLines="25"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:text="@string/output_placeholder"
                android:textColor="@color/code_text"
                android:textSize="11sp"
                android:typeface="monospace" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
